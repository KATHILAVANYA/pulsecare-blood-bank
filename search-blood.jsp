<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Search blood · PulseCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body><%@ include file="nav.jspf" %><main class="main"><div class="page-head"><div><p class="eyebrow">AVAILABILITY</p><h1>Search blood</h1><p class="muted">Check the inventory quantity only. Medical compatibility must be confirmed by qualified personnel.</p></div></div><section class="panel search-panel"><h3>Check availability</h3><form method="post" action="${pageContext.request.contextPath}/blood-availability" class="row g-3"><div class="col-md-6"><label>Blood group</label><select class="form-select" name="bloodGroup"><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></div><div class="col-md-6"><label>Units required</label><input class="form-control" type="number" min="1" max="100" name="quantity" value="1" required></div><div class="col-12"><button class="btn btn-danger">Check stock</button></div></form><c:if test="${not empty error}"><div class="alert alert-danger mt-3"><c:out value="${error}"/></div></c:if><c:if test="${not empty group}"><hr><div class="row g-3 mt-1"><div class="col-md-4"><div class="metric"><span>Blood group</span><strong><c:out value="${group}"/></strong></div></div><div class="col-md-4"><div class="metric"><span>Available units</span><strong>${units}</strong></div></div><div class="col-md-4"><div class="metric"><span>Requested units</span><strong>${requested}</strong></div></div></div><div class="alert ${available?'alert-success':'alert-warning'} mt-3"><c:choose><c:when test="${available}">Inventory currently lists ${units} units for <c:out value="${group}"/>.</c:when><c:otherwise>Insufficient stock. Requested ${requested}, currently listed ${units}.</c:otherwise></c:choose><br><small>Last inventory update: <c:out value="${updated}"/></small></div></c:if></section></main></body></html>

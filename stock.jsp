<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Blood stock · PulseCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body><%@ include file="nav.jspf" %><main class="main"><div class="page-head"><div><p class="eyebrow">INVENTORY</p><h1>Blood stock</h1><p class="muted">Stock is measured in demo units. Every manual adjustment is recorded.</p></div></div><section class="panel mb-4"><div class="table-responsive"><table class="table"><thead><tr><th>Group</th><th>Available</th><th>Minimum</th><th>Status</th><th>Updated</th></tr></thead><tbody><c:forEach var="s" items="${stock}"><tr><td><span class="blood-pill"><c:out value="${s.group}"/></span></td><td><strong>${s.units}</strong></td><td>${s.threshold}</td><td><c:choose><c:when test="${s.units==0}"><span class="badge text-bg-danger">Critical</span></c:when><c:when test="${s.units<s.threshold}"><span class="badge text-bg-warning">Low</span></c:when><c:otherwise><span class="badge text-bg-success">Sufficient</span></c:otherwise></c:choose></td><td><c:out value="${s.updated}"/></td></tr></c:forEach></tbody></table></div></section><div class="row g-3"><div class="col-lg-7"><section class="panel"><h3>Adjust inventory</h3><form method="post" action="${pageContext.request.contextPath}/stock-adjust" class="row g-3"><div class="col-md-6"><label>Blood group</label><select class="form-select" name="bloodGroup"><c:forEach var="s" items="${stock}"><option value="${s.group}"><c:out value="${s.group}"/></option></c:forEach></select></div><div class="col-md-6"><label>Action</label><select class="form-select" name="direction"><option value="add">Add units</option><option value="remove">Remove units</option></select></div><div class="col-md-6"><label>Quantity</label><input class="form-control" type="number" min="0" max="10000" name="quantity" value="1" required></div><div class="col-md-6"><label>Reason</label><input class="form-control" name="reason" required></div><div class="col-12"><input type="hidden" name="kind" value="adjust"><button class="btn btn-danger">Save adjustment</button></div></form></section></div><div class="col-lg-5"><section class="panel"><h3>Change minimum threshold</h3><form method="post" action="${pageContext.request.contextPath}/stock" class="row g-3"><div class="col-12"><label>Blood group</label><select class="form-select" name="bloodGroup"><c:forEach var="s" items="${stock}"><option value="${s.group}"><c:out value="${s.group}"/></option></c:forEach></select></div><div class="col-12"><label>Minimum units</label><input class="form-control" type="number" min="0" name="threshold" value="5" required></div><input type="hidden" name="quantity" value="0"><input type="hidden" name="kind" value="threshold"><div class="col-12"><button class="btn btn-outline-danger">Update threshold</button></div></form></section></div></div></main></body></html>

<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Receipt · PulseCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body class="receipt-bg"><div class="receipt-toolbar"><a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/receipts">← Receipts</a><button class="btn btn-danger" onclick="window.print()">Print / Save PDF</button></div><main class="receipt"><div class="receipt-header"><div class="brand"><span>🩸</span> PulseCare</div><p>Blood Bank Management System</p><h1>Donation Receipt</h1></div><div class="receipt-number">Receipt No. <strong><c:out value="${receipt.receipt}"/></strong></div><div class="receipt-grid"><div><small>Donor ID</small><strong>#${receipt.donorId}</strong></div><div><small>Donor name</small><strong><c:out value="${receipt.name}"/></strong></div><div><small>Blood group</small><strong><c:out value="${receipt.group}"/></strong></div><div><small>Quantity collected</small><strong>${receipt.quantity} unit(s)</strong></div><div><small>Donation ID</small><strong>#${receipt.donationId}</strong></div><div><small>Donation date</small><strong><c:out value="${receipt.date}"/></strong></div><div><small>Collection centre</small><strong><c:out value="${receipt.centre}"/></strong></div><div><small>Recorded by</small><strong><c:out value="${receipt.staff}"/></strong></div></div><p class="thank-you">Thank you for your generous contribution. Your donation can help save lives.</p><small class="muted">Generated <c:out value="${receipt.generated}"/> · Keep this receipt for your records.</small></main><style>@media print{.receipt-toolbar{display:none}.receipt-bg{background:white}.receipt{box-shadow:none;margin:0 auto}}</style></body></html>

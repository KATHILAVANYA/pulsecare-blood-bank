<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reports · PulseCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body><%@ include file="nav.jspf" %><main class="main"><div class="page-head"><div><p class="eyebrow">AUDIT & REPORTING</p><h1>Reports & stock transactions</h1><p class="muted">Latest 100 stock changes recorded by staff.</p></div><button class="btn btn-outline-danger" onclick="downloadCsv()">Export CSV</button></div><section class="panel"><div class="table-responsive"><table id="txTable" class="table"><thead><tr><th>ID</th><th>Blood group</th><th>Type</th><th>Quantity (+/-)</th><th>Reason</th><th>Date</th></tr></thead><tbody><c:forEach var="t" items="${transactions}"><tr><td>${t.id}</td><td><c:out value="${t.group}"/></td><td><c:out value="${t.type}"/></td><td>${t.qty}</td><td><c:out value="${t.reason}"/></td><td><c:out value="${t.date}"/></td></tr></c:forEach><c:if test="${empty transactions}"><tr><td colspan="6" class="text-center muted">No stock transactions recorded.</td></tr></c:if></tbody></table></div></section></main><script>function downloadCsv(){const rows=[...document.querySelectorAll('#txTable tr')].map(r=>[...r.children].map(c=>'"'+c.innerText.replaceAll('"','""')+'"').join(','));const blob=new Blob([rows.join('\r\n')],{type:'text/csv'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='stock-transactions.csv';a.click();URL.revokeObjectURL(a.href)}</script></body></html>

<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Record donation · PulseCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body><%@ include file="nav.jspf" %><main class="main"><div class="page-head"><div><p class="eyebrow">DONATIONS</p><h1>Record donation</h1><p class="muted">Saving an accepted donation updates the donor's blood group stock in one database transaction.</p></div></div><section class="panel mb-4"><h3>Donation entry</h3><form method="post" action="${pageContext.request.contextPath}/donations" class="row g-3"><div class="col-md-6"><label>Donor *</label><select class="form-select" name="donorId" required><option value="">Select donor</option><c:forEach var="d" items="${donors}"><option value="${d.id}">#${d.id} · <c:out value="${d.name}"/> (<c:out value="${d.group}"/>)</option></c:forEach></select></div><div class="col-md-3"><label>Quantity (units) *</label><input class="form-control" type="number" name="quantity" min="1" max="5" value="1" required></div><div class="col-md-3"><label>Collection centre *</label><input class="form-control" name="centre" required></div><div class="col-12"><label>Remarks</label><textarea class="form-control" name="remarks" rows="2"></textarea></div><input type="hidden" name="requestToken" value="<%= java.util.UUID.randomUUID().toString() %>"><div class="col-12"><button class="btn btn-danger">Save donation & generate receipt</button></div></form></section><section class="panel"><h3>Recent donations</h3><div class="table-responsive"><table class="table"><thead><tr><th>ID</th><th>Donor</th><th>Group</th><th>Units</th><th>Date</th><th>Receipt</th></tr></thead><tbody><c:forEach var="d" items="${donations}"><tr><td>${d.id}</td><td><c:out value="${d.name}"/></td><td><c:out value="${d.group}"/></td><td>${d.quantity}</td><td><c:out value="${d.date}"/></td><td><a href="${pageContext.request.contextPath}/receipts?id=${d.id}">View receipt</a></td></tr></c:forEach></tbody></table></div></section></main></body></html>

<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · PulseCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head>
<body class="auth-bg"><div class="auth-wrap"><div class="auth-art"><div class="brand-mark">🩸</div><h1>Every drop<br>can save a life.</h1><p>Blood bank operations, donor records and stock visibility in one secure workspace.</p><div class="blood-drop">+</div></div><div class="auth-card"><div class="brand"><span>🩸</span> PulseCare</div><h2>Welcome back</h2><p class="muted">Sign in to your staff account.</p><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/login"><label>Email address</label><input class="form-control mb-3" type="email" name="email" autocomplete="username" required><label>Password</label><div class="input-group mb-3"><input id="pw" class="form-control" type="password" name="password" autocomplete="current-password" required><button class="btn btn-outline-secondary" type="button" onclick="togglePw()">Show</button></div><div class="d-grid"><button class="btn btn-danger btn-lg" type="submit">Sign in</button></div></form><p class="mt-4 mb-0">First time here? <a href="${pageContext.request.contextPath}/register">Create staff account</a></p><small class="muted d-block mt-4">Academic demonstration · Use only demo data</small></div></div><script>function togglePw(){const p=document.getElementById('pw');p.type=p.type==='password'?'text':'password'}</script></body></html>

<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create account · PulseCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body class="auth-bg"><div class="auth-wrap"><div class="auth-art"><div class="brand-mark">🩸</div><h1>Care starts<br>with connection.</h1><p>Create a staff account to manage donors, donations and inventory.</p><div class="blood-drop">+</div></div><div class="auth-card"><div class="brand"><span>🩸</span> PulseCare</div><h2>Create account</h2><p class="muted">Passwords are hashed before storage.</p><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/register"><label>Full name</label><input class="form-control mb-3" name="fullName" required maxlength="120"><label>Email address</label><input class="form-control mb-3" type="email" name="email" required><label>Password (minimum 8 characters)</label><input class="form-control mb-4" type="password" name="password" minlength="8" required><button class="btn btn-danger btn-lg w-100">Create account</button></form><p class="mt-4 mb-0">Already registered? <a href="${pageContext.request.contextPath}/login">Sign in</a></p></div></div></body></html>

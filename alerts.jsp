<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Alerts · PulseCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body><%@ include file="nav.jspf" %><main class="main"><div class="page-head"><div><p class="eyebrow">ATTENTION</p><h1>Low-stock alerts</h1><p class="muted">Groups below the configured minimum stock threshold.</p></div></div><section class="panel"><c:choose><c:when test="${empty lowStock}"><div class="alert alert-success">No low-stock alerts right now.</div></c:when><c:otherwise><div class="table-responsive"><table class="table"><thead><tr><th>Blood group</th><th>Current units</th><th>Minimum threshold</th><th>Severity</th><th>Action</th></tr></thead><tbody><c:forEach var="s" items="${lowStock}"><tr><td><strong><c:out value="${s.group}"/></strong></td><td>${s.units}</td><td>${s.threshold}</td><td><span class="badge ${s.units==0?'text-bg-danger':'text-bg-warning'}">${s.units==0?'Critical':'Low stock'}</span></td><td><a href="${pageContext.request.contextPath}/stock">Manage stock</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></main></body></html>

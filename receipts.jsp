<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Receipts · PulseCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body><%@ include file="nav.jspf" %><main class="main"><div class="page-head"><div><p class="eyebrow">DOCUMENTS</p><h1>Donation receipts</h1><p class="muted">Reopen and print a receipt generated for a saved donation.</p></div><a class="btn btn-danger" href="${pageContext.request.contextPath}/donations">Record donation</a></div><section class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Receipt</th><th>Donation ID</th><th>Donor</th><th>Group</th><th>Units</th><th>Date</th><th></th></tr></thead><tbody><c:forEach var="d" items="${donations}"><tr><td><c:out value="${d.receipt}"/></td><td>${d.id}</td><td><c:out value="${d.name}"/></td><td><c:out value="${d.group}"/></td><td>${d.quantity}</td><td><c:out value="${d.date}"/></td><td><a class="btn btn-sm btn-outline-danger" href="${pageContext.request.contextPath}/receipts?id=${d.id}">Preview / print</a></td></tr></c:forEach><c:if test="${empty donations}"><tr><td colspan="7" class="text-center muted">No receipts yet.</td></tr></c:if></tbody></table></div></section></main></body></html>

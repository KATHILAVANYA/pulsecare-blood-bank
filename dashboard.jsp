<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard · PulseCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"><script src="https://cdn.jsdelivr.net/npm/chart.js"></script></head><body><%@ include file="nav.jspf" %><main class="main"><div class="page-head"><div><p class="eyebrow">OVERVIEW</p><h1>Dashboard</h1><p class="muted">Welcome, <c:out value="${sessionScope.fullName}"/>. Here is your current inventory snapshot.</p></div><a class="btn btn-danger" href="${pageContext.request.contextPath}/donations">＋ Record donation</a></div><div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="metric"><span>Registered donors</span><strong>${donorCount}</strong><small>Active donor records</small></div></div><div class="col-6 col-xl-3"><div class="metric"><span>Available units</span><strong>${totalUnits}</strong><small>Across all blood groups</small></div></div><div class="col-6 col-xl-3"><div class="metric"><span>Groups in stock</span><strong>${groupsInStock}/8</strong><small>Blood groups with units</small></div></div><div class="col-6 col-xl-3"><div class="metric"><span>Donations this month</span><strong>${monthDonations}</strong><small>Accepted donations</small></div></div></div><div class="row g-3"><div class="col-lg-7"><section class="panel"><h3>Stock by blood group</h3><canvas id="stockChart" height="120"></canvas></section></div><div class="col-lg-5"><section class="panel"><h3>Low-stock alerts</h3><c:choose><c:when test="${empty lowStock}"><div class="alert alert-success">All groups are at or above minimum stock.</div></c:when><c:otherwise><c:forEach var="s" items="${lowStock}"><div class="alert alert-warning d-flex justify-content-between"><strong><c:out value="${s.group}"/></strong><span>${s.units} units / min ${s.threshold}</span></div></c:forEach></c:otherwise></c:choose><a href="${pageContext.request.contextPath}/alerts">View all alerts →</a></section></div><div class="col-12"><section class="panel"><h3>Recent donations</h3><div class="table-responsive"><table class="table align-middle"><thead><tr><th>ID</th><th>Donor</th><th>Blood group</th><th>Units</th><th>Date</th><th>Status</th></tr></thead><tbody><c:forEach var="d" items="${recent}"><tr><td>#${d.id}</td><td><c:out value="${d.name}"/></td><td><span class="blood-pill"><c:out value="${d.group}"/></span></td><td>${d.quantity}</td><td><c:out value="${d.date}"/></td><td><span class="status">${d.status}</span></td></tr></c:forEach><c:if test="${empty recent}"><tr><td colspan="6" class="text-center muted">No donations recorded yet.</td></tr></c:if></tbody></table></div></section></div></div></main><script>const labels=[<c:forEach var="s" items="${stock}" varStatus="i">'${s.group}'<c:if test="${!i.last}">,</c:if></c:forEach>];const vals=[<c:forEach var="s" items="${stock}" varStatus="i">${s.units}<c:if test="${!i.last}">,</c:if></c:forEach>];new Chart(document.getElementById('stockChart'),{type:'bar',data:{labels,datasets:[{label:'Available units',data:vals,backgroundColor:'#c62828',borderRadius:7}]},options:{responsive:true,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true}}}});</script></body></html>

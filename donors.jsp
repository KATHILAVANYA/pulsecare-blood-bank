<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Donors · PulseCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body><%@ include file="nav.jspf" %><main class="main"><div class="page-head"><div><p class="eyebrow">PEOPLE</p><h1>Donor management</h1><p class="muted">Register and search donor records. Eligibility must be confirmed by qualified staff.</p></div></div><section class="panel mb-4"><h3>Register donor</h3><form method="post" action="${pageContext.request.contextPath}/donors" class="row g-3"><div class="col-md-4"><label>Full name *</label><input class="form-control" name="fullName" required maxlength="120"></div><div class="col-md-4"><label>Email</label><input class="form-control" type="email" name="email"></div><div class="col-md-4"><label>Phone *</label><input class="form-control" name="phone" required></div><div class="col-md-3"><label>Blood group *</label><select class="form-select" name="bloodGroup" required><c:forEach var="g" items="${groups}"><option><c:out value="${g}"/></option></c:forEach></select></div><div class="col-md-3"><label>Date of birth</label><input class="form-control" type="date" name="dob"></div><div class="col-md-3"><label>Gender</label><select class="form-select" name="gender"><option value="">Prefer not to say</option><option>Female</option><option>Male</option><option>Other</option></select></div><div class="col-md-3"><label>Address</label><input class="form-control" name="address"></div><div class="col-12"><button class="btn btn-danger">Save donor</button></div></form></section><section class="panel"><div class="d-flex justify-content-between flex-wrap gap-2"><h3>Donor directory</h3><form class="d-flex gap-2" method="get"><input class="form-control" name="q" placeholder="Name, ID, phone or email" value="<c:out value='${q}'/>"><select class="form-select" name="group"><option value="">All groups</option><c:forEach var="g" items="${groups}"><option value="${g}" ${selectedGroup==g?'selected':''}><c:out value="${g}"/></option></c:forEach></select><button class="btn btn-outline-danger">Search</button></form></div><div class="table-responsive mt-3"><table class="table align-middle"><thead><tr><th>ID</th><th>Name</th><th>Blood group</th><th>Phone</th><th>Email</th><th>Registered</th><th>Eligibility</th><th></th></tr></thead><tbody><c:forEach var="d" items="${donors}"><tr><td>${d.id}</td><td><c:out value="${d.name}"/></td><td><span class="blood-pill"><c:out value="${d.group}"/></span></td><td><c:out value="${d.phone}"/></td><td><c:out value="${d.email}"/></td><td><c:out value="${d.registered}"/></td><td><c:out value="${d.eligibility}"/></td><td><form method="post" onsubmit="return confirm('Deactivate this donor record?')"><input type="hidden" name="action" value="deactivate"><input type="hidden" name="id" value="${d.id}"><button class="btn btn-sm btn-outline-secondary">Deactivate</button></form></td></tr></c:forEach><c:if test="${empty donors}"><tr><td colspan="8" class="text-center muted">No donor records match.</td></tr></c:if></tbody></table></div></section></main></body></html>
